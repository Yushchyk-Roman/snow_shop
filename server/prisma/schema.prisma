generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id    Int    @id @default(autoincrement())
  title String
  brand String
  price Int
  image String

  badges String[]
  specs  String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
