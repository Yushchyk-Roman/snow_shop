generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  BOARD
  BINDING
  BOOT
  GEAR
}

model Product {
  id          Int    @id @default(autoincrement())
  title       String
  slug        String @unique
  brand       String
  description String
  category Category

  price    Int
  oldPrice Int?
  stock    Int  @default(0)

  images String[]
  badges String[]

  attributes Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
